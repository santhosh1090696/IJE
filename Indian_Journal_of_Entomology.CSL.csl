
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0">
  <info>
    <title>Indian Journal of Entomology</title>
    <id>http://www.zotero.org/styles/indian-journal-of-entomology</id>
    <link href="http://www.zotero.org/styles/indian-journal-of-entomology" rel="self"/>
    <author>
      <name>Custom</name>
    </author>
    <category citation-format="author-date"/>
    <updated>2025-02-12</updated>
  </info>

  <!-- Macro for Author -->
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " name-as-sort-order="all" sort-separator=", "/>
    </names>
  </macro>
  
  <!-- Macro for Title -->
  <macro name="title">
    <text variable="title"/>
  </macro>
  
  <!-- Macro for Year -->
  <macro name="year">
    <text variable="issued" prefix="(" suffix=")"/>
  </macro>
  
  <!-- Macro for Journal -->
  <macro name="journal">
    <text variable="container-title" font-style="italic"/>
  </macro>
  
  <!-- Macro for Volume -->
  <macro name="volume">
    <text variable="volume"/>
  </macro>
  
  <!-- Macro for Issue -->
  <macro name="issue">
    <text variable="issue" prefix="("/>
  </macro>
  
  <!-- Macro for Pages -->
  <macro name="pages">
    <text variable="page"/>
  </macro>
  
  <!-- Macro for Publisher -->
  <macro name="publisher">
    <text variable="publisher"/>
  </macro>
  
  <!-- Citation Layout -->
  <citation>
    <layout delimiter=" ">
      <text macro="author"/>
      <text macro="year"/>
      <text macro="title"/>
      <text macro="journal"/>
      <text macro="volume"/>
      <text macro="issue"/>
      <text macro="pages"/>
    </layout>
  </citation>
  
  <!-- Bibliography Layout -->
  <bibliography>
    <layout delimiter=" ">
      <text macro="author"/>
      <text macro="year"/>
      <text macro="title"/>
      <text macro="journal"/>
      <text macro="volume"/>
      <text macro="issue"/>
      <text macro="pages"/>
      <text macro="publisher"/>
    </layout>
  </bibliography>
</style>
